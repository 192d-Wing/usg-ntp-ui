# Base URL of the ntp_usg management API.
#
# Leave unset to run the console against its built-in simulation. For a
# same-origin deployment, leave it unset in production too and let the reverse
# proxy route /api to the server.
# VITE_API_BASE_URL=https://ntp.example.mil

# Development only: the Vite dev server proxies /api to this address, so the
# console can talk to a local server without any CORS configuration.
# VITE_DEV_API_TARGET=http://localhost:8080
